# HISPANSHIELD — environment configuration
# Copy to .env and replace every CHANGE_ME value. Never commit .env.

HS_ENV=development
HS_DEBUG=false
HS_LOG_LEVEL=INFO

# PostgreSQL (psycopg3 SQLAlchemy URL)
HS_DATABASE_URL=postgresql+psycopg://hispanshield:CHANGE_ME@localhost:5432/hispanshield

# Cryptographic material. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HS_SECRET_KEY=CHANGE_ME_64_BYTES_RANDOM
HS_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY

# Session / cookie
HS_SESSION_TTL_MINUTES=720
HS_COOKIE_SECURE=true
HS_COOKIE_DOMAIN=
HS_ALLOWED_ORIGINS=https://shield.example.eu

# Initial platform administrator (used once by scripts/bootstrap_admin.py)
HS_BOOTSTRAP_ADMIN_EMAIL=admin@example.eu
HS_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
HS_BOOTSTRAP_ORG_NAME=HISPANSHIELD Demo Organisation

# Rate limiting
HS_RATE_LIMIT_ENABLED=true
HS_RATE_LIMIT_PER_MINUTE=240
HS_LOGIN_RATE_LIMIT_PER_MINUTE=10

# AI providers (optional, local-first). Example Ollama endpoint.
HS_DEFAULT_OLLAMA_URL=http://127.0.0.1:11434
HS_AI_REQUEST_TIMEOUT_SECONDS=120
HS_AI_MAX_CONCURRENCY=4

# Connector egress policy: comma separated CIDRs considered NOT reachable
# (SSRF protection). Empty uses the safe default deny-list.
HS_CONNECTOR_DENY_CIDRS=
HS_CONNECTOR_ALLOW_PRIVATE_NETWORKS=false

# Metrics endpoint protection
HS_METRICS_TOKEN=CHANGE_ME_METRICS_TOKEN

# Demo data is NEVER enabled automatically in production.
HS_SEED_DEMO=false

# Deployment metadata
HS_PUBLIC_URL=http://localhost:8080
HS_SUPPORT_EMAIL=security@example.eu
