# HISPANSHIELD — environment configuration
# Copy to .env and replace every CHANGE_ME value. Never commit .env.

HS_ENV=development
HS_DEBUG=false
HS_LOG_LEVEL=INFO

# PostgreSQL (psycopg3 SQLAlchemy URL)
HS_DATABASE_URL=postgresql+psycopg://hispanshield:CHANGE_ME@localhost:5432/hispanshield

# Cryptographic material. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HS_SECRET_KEY=CHANGE_ME_64_BYTES_RANDOM
HS_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY

# Session / cookie
HS_SESSION_TTL_MINUTES=720
HS_SESSION_IDLE_MINUTES=30
HS_COOKIE_SECURE=true
HS_COOKIE_DOMAIN=
HS_ALLOWED_ORIGINS=https://shield.example.eu

# Audit integrity: HMAC key custody outside PostgreSQL (required in production).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
HS_AUDIT_HMAC_KEY=CHANGE_ME_AUDIT_HMAC_KEY
HS_AUDIT_HMAC_KEY_ID=k1
# Retired keys kept for verification after rotation: "k0:secret,k-1:secret"
HS_AUDIT_HMAC_PREVIOUS_KEYS=
HS_AUDIT_REQUIRE_HMAC=true

# Initial platform administrator (used once by scripts/bootstrap_admin.py)
HS_BOOTSTRAP_ADMIN_EMAIL=admin@example.eu
HS_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
HS_BOOTSTRAP_ORG_NAME=HISPANSHIELD Demo Organisation
# Optional shared secret for POST /setup (recommended on first boot).
HS_SETUP_TOKEN=

# Rate limiting
HS_RATE_LIMIT_ENABLED=true
HS_RATE_LIMIT_PER_MINUTE=240
HS_LOGIN_RATE_LIMIT_PER_MINUTE=10

# AI providers (optional, local-first). Example Ollama endpoint.
HS_DEFAULT_OLLAMA_URL=http://127.0.0.1:11434
HS_AI_REQUEST_TIMEOUT_SECONDS=120
HS_AI_MAX_CONCURRENCY=4
HS_AI_MAX_CONCURRENCY_PER_ORG=2
# Per-organization spend guards (0 blocks inference for that org).
HS_AI_DAILY_TOKEN_BUDGET_PER_ORG=2000000
HS_AI_MONTHLY_TOKEN_BUDGET_PER_ORG=20000000
HS_AI_DAILY_REQUEST_BUDGET_PER_ORG=5000
# External providers require this flag AND org settings.ai.external_opt_in=true
# AND provider.config.data_region starting with "eu".
HS_AI_ALLOW_EXTERNAL_PROVIDERS=false
# Private CIDRs allowed for local inference servers (SSRF allowlist).
HS_AI_PRIVATE_ALLOWED_CIDRS=127.0.0.0/8,::1/128

# Connector egress policy: comma separated CIDRs considered NOT reachable
# (SSRF protection). Empty uses the safe default deny-list.
HS_CONNECTOR_DENY_CIDRS=
HS_CONNECTOR_ALLOW_PRIVATE_NETWORKS=false

# Trusted reverse proxies allowed to set X-Forwarded-For (uvicorn).
HS_FORWARDED_ALLOW_IPS=127.0.0.1

# Backups: in production the dump/evidence are encrypted with this GPG recipient.
# HS_BACKUP_ENCRYPTION=required
# BACKUP_GPG_RECIPIENT=security@example.eu

# Metrics endpoint protection
HS_METRICS_TOKEN=CHANGE_ME_METRICS_TOKEN

# Demo data is NEVER enabled automatically in production.
HS_SEED_DEMO=false

# Deployment metadata
HS_PUBLIC_URL=http://localhost:8080
HS_SUPPORT_EMAIL=security@example.eu
