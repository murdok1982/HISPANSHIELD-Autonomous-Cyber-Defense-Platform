# Copy to values.production.env, replace every value out of band, never commit.
# render.sh refuses placeholders before it emits a manifest.
HS_IMAGE=registry.internal/hispanshield:0.1.1
HS_DOMAIN=shield.your-domain.eu
HS_DB_HOST=postgres.your-domain.internal
HS_DB_PASSWORD=REPLACE_ME_WITH_A_LONG_RANDOM_PASSWORD
HS_SECRET_KEY=REPLACE_ME_WITH_64_RANDOM_BYTES
HS_ENCRYPTION_KEY=REPLACE_ME_WITH_A_FERNET_KEY
HS_AUDIT_HMAC_KEY=REPLACE_ME_WITH_48_RANDOM_BYTES
HS_AUDIT_HMAC_PREVIOUS_KEYS=
HS_METRICS_TOKEN=REPLACE_ME_WITH_A_LONG_RANDOM_TOKEN
HS_BOOTSTRAP_ADMIN_EMAIL=admin@your-domain.eu
HS_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_ME_WITH_A_STRONG_PASSWORD
HS_SETUP_TOKEN=REPLACE_ME_WITH_A_RANDOM_SETUP_TOKEN
HS_STORAGE_CLASS=encrypted-rwx
